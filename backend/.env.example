# ── Base de données ──────────────────────────────────────────────
MONGO_URI="mongodb+srv://user:password@cluster.mongodb.net/maison_love_room"

# ── Authentification admin ───────────────────────────────────────
JWT_SECRET="une_chaine_longue_et_aleatoire"
NODE_ENV="development"           # "production" en prod (cookies sécurisés)
PORT="5000"

# ── Frontend autorisé (CORS) ─────────────────────────────────────
# Une ou plusieurs origines séparées par des virgules.
FRONTEND_URL="http://localhost:5173,https://maisonloverooms.vercel.app"

# ── Emails (nodemailer) ──────────────────────────────────────────
EMAIL_HOST="smtp.exemple.com"
EMAIL_PORT="465"
EMAIL_SECURE="true"
EMAIL_USER="contact@maisonloverooms.fr"
EMAIL_PASS="mot_de_passe_smtp"

# ── Stripe ───────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_live_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ── Synchronisation iCal (Airbnb / Booking) ──────────────────────
# Secret partagé qui protège l'endpoint de synchro appelé par le cron externe.
# OBLIGATOIRE en production : sans lui, GET /api/cron/sync-ical répond 401.
CRON_SECRET="un_autre_secret_long_et_aleatoire"

# Fréquence (minutes) de la synchro auto en DEV LOCAL uniquement (serveur long-running).
# En serverless (Vercel), c'est le cron externe qui pilote — voir SYNC_ICAL.md.
ICAL_SYNC_INTERVAL_MINUTES="15"

# Anti-martèlement : à l'ouverture du back-office, on ne resynchronise une suite
# que si sa dernière synchro dépasse ce seuil (minutes).
ICAL_LAZY_THROTTLE_MINUTES="5"
